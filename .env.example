# Salin ke .env lokal. Jangan unggah .env ke GitHub.
# Ambil connection string terbaru dari Neon; jangan gunakan URL contoh.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NODE_ENV=production
TRUST_PROXY=true
APP_NAME=Absensi Siswa
LEMBAGA=SMP
TAHUN_PELAJARAN=2026/2027
TZ=Asia/Jakarta
SESSION_DURATION_MS=86400000
SESSION_SECRET=generate-a-long-random-secret-if-used-by-your-code
APP_CRON_SECRET=generate-a-different-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
